#!/usr/bin/env bash
# The Hub owns the conversation; flags pass through to jarvis-hub.
set -euo pipefail

# Follow symlinks such as ~/.local/bin/jarvis so the session opens in this repo.
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
cd "$(cd "$(dirname "$src")" && pwd)"

exec uv run jarvis-hub "$@"
