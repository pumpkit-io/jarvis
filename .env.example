# Copy to .env (gitignored) and fill in. The Hub parses it at startup; it is never sourced.
# The process environment overrides it, e.g. `JARVIS_TALKER_MODEL=haiku jarvis-hub --text`.

# Your name. Jarvis greets you with it and otherwise calls you "sir".
JARVIS_USER_NAME=

# The GitHub organization whose repos Jarvis covers.
JARVIS_GITHUB_ORG=pumpkit-io

# The Talker's model, run at low effort with thinking off. Sonnet by default (docs/adr/0005).
JARVIS_TALKER_MODEL=sonnet

# The Orchestrator's model, used to plan Tasks and judge Subagent results.
JARVIS_ORCHESTRATOR_MODEL=sonnet
# The Orchestrator's effort: low, medium, high, xhigh or max.
JARVIS_ORCHESTRATOR_EFFORT=medium

# Voice mode (`jarvis-hub` without --text). Times in seconds unless the name says MS.
# Startup and unavailable status appear on screen; speech readiness uses a nonverbal cue.
# In an interactive voice terminal, Ctrl-G stops the spoken reply without Enter and preserves typed text.
# Opt-in: jev sends bounded candidate text, timings and context to TypeSafe; raw audio stays local.
# Legacy endpoint-only Claude admission remains an explicit option; no provider fallback is used.
JARVIS_ADMISSION_BACKEND=off
# Legacy Claude classifier model. Jev is pinned in code to jev-1.14.0.
JARVIS_ADMISSION_MODEL=sonnet
# Required only for JARVIS_ADMISSION_BACKEND=jev; may also come from the process environment.
TYPESAFE_API_KEY=

# Listening after a reply with no Wake word needed, then idle without a word.
JARVIS_FOLLOWUP_SECONDS=6
# The same window after an Announcement.
JARVIS_ANNOUNCE_FOLLOWUP_SECONDS=4
# How long Jarvis waits for the User to start speaking after the Wake word.
JARVIS_LISTEN_SECONDS=6
# Wake word engine: openwakeword's "hey_jarvis" (pretrained model CC BY-NC-SA 4.0, non-commercial).
JARVIS_WAKE_ENGINE=openwakeword
# Opt-in experimental idle-only route: apple-vad. See docs/notes/apple-vad-wake.md for local setup and open gates.
# Wake word score needed, 0 to 1; lower hears more takes and more false wakes.
JARVIS_WAKE_THRESHOLD=0.5
# Speech-to-text engine: parakeet (parakeet-mlx, in-process).
JARVIS_STT_ENGINE=parakeet
# Text-to-speech engine: kokoro (Kokoro on MLX, in-process).
JARVIS_TTS_ENGINE=kokoro
# Echo cancellation: webrtc, or off (as `--headphones` sets it).
JARVIS_AEC=webrtc
# Silero VAD speech probability, 0 to 1.
JARVIS_VAD_THRESHOLD=0.5
# Silence before Smart Turn judges whether the turn has ended.
JARVIS_END_SILENCE_MS=500
# Extra silence allowed when Smart Turn says the turn is incomplete.
JARVIS_END_EXTEND_MS=1500
# Smart Turn probability of "complete" needed to end the turn, 0 to 1.
JARVIS_SMART_TURN_THRESHOLD=0.5
# Audio kept from before the Wake word or the speech onset, so "Hey Jarvis, open..." in one breath is heard whole.
JARVIS_PREROLL_MS=1500
# Audio kept from before VAD's speech onset, which fires a little late.
JARVIS_ONSET_PAD_MS=200
# A turn this long ends whatever VAD says, so a noisy room cannot hold listening open.
JARVIS_MAX_TURN_SECONDS=30
# Wake word hits this soon after the chime starts playing are its echo, and are ignored. The chime is 180 ms.
JARVIS_CHIME_GUARD_MS=500
# Wake word hits this soon after one are the same phrase.
JARVIS_WAKE_REFRACTORY_MS=2000
# Audio clips, off by default: `on` saves captured turn candidates as local 16 kHz WAVs with JSON sidecars.
# Candidates can include background speech rejected by admission; files stay under gitignored .jarvis/clips/.
JARVIS_AUDIO_CLIPS=off
# Maximum stored clips; the oldest go first, at startup and after each write when clips are enabled.
JARVIS_CLIPS_MAX_COUNT=500
# Maximum clip age in days, pruned while clips are enabled.
JARVIS_CLIPS_MAX_DAYS=14
# Maximum combined WAV and sidecar size in decimal MB, pruned while clips are enabled.
JARVIS_CLIPS_MAX_MB=500

# Restart the Talker once its context passes this fraction of the model's window, to keep long conversations fast.
JARVIS_TALKER_RESTART_AT=0.40

# The highest effort any Subagent may run at (low, medium, high, xhigh, max). Even below it,
# xhigh and max run only when you ask for them.
JARVIS_MAX_EFFORT=max

# How many Subagents run at once; more wait in a queue. They all share your Max limits.
JARVIS_MAX_SUBAGENTS=3
